{
    "name": "blight-magic",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @blight/server\" \"npm run dev -w @blight/client\"",
        "start": "npm run start -w @blight/server",
        "build": "npm run build -w @blight/client",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "lint": "eslint packages",
        "lint:fix": "eslint --fix packages",
        "format": "prettier --check packages",
        "format:fix": "prettier --write packages",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run typecheck && npm run lint && npm run format && npm test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.4",
        "concurrently": "^10.0.5",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "vitest": "^5.0.3"
    }
}
